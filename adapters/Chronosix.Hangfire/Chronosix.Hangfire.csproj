<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(ChronosixTargetFrameworks)' != ''">$(ChronosixTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(ChronosixTargetFrameworks)' == ''">net8.0;net9.0;net10.0</TargetFrameworks>

    <PackageId>Chronosix.Hangfire</PackageId>
    <Title>Chronosix Hangfire Adapter</Title>
    <Description>Surfaces Hangfire background jobs on the Chronosix dashboard — server executions appear on the live timeline and job exceptions feed the failure tracer. Targets Hangfire 1.8.x.</Description>
    <PackageTags>chronosix;hangfire;background-jobs;dashboard;diagnostics</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Hangfire.Core" Version="1.8.17" />
    <!--
      Hangfire.Core pulls in Newtonsoft.Json 11.0.1 transitively, which has a known
      high-severity advisory (NU1903 / GHSA-5crp-9r3c-p9vr). A direct reference at the
      latest version overrides the transitive one and clears the warning.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Chronosix/Chronosix.csproj" />
  </ItemGroup>

</Project>
